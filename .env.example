LIARA_ATTACHMENT_SCAN_MODE=wsl-clamd
LIARA_ATTACHMENT_SCAN_TIMEOUT_SECONDS=15
LIARA_ATTACHMENT_SCAN_ALLOW_FALLBACK=true
# Optional custom command, receives the canonical WSL file path as {path}.
# LIARA_ATTACHMENT_SCAN_COMMAND=clamdscan --no-summary --fdpass -- {path}
MAX_REASONING_STEPS=5
MAX_STEP_CONTEXT_TOKENS=4000
SAFETY_MARGIN_TOKENS=1000
INFERENCE_QUEUE_REQUEST_STREAM=liara:inference:requests
INFERENCE_QUEUE_RESPONSE_STREAM_PREFIX=liara:inference:responses
INFERENCE_QUEUE_CONSUMER_GROUP=liara-inference-workers
INFERENCE_QUEUE_BLOCK_MS=1000

