OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLAMA_CPP_BASE_URL=http://127.0.0.1:8000
LLAMA_CPP_MODEL=C:\ai\models\llama\models\qwen2.5-3b-ollama-export.gguf
# Separate models for coding and instruct, if supported by the provider.
# used for Code
LLAMA_CPP_MODEL_CODING=C:\ai\models\llama\models\qwen2.5-coder-3b-ollama-export.gguf
# If the provider supports it, an instruction-tuned model can be used for non-coding tasks, which may improve performance and reduce costs.
# used for Instruct, Math, Reasoning and "Thinking" steps
LLAMA_CPP_MODEL_INSTRUCT=C:\ai\models\llama\models\qwen2.5-instruction-3b-ollama-export.gguf
# If the provider supports it, a vision-capable model can be used for tasks involving images, which may improve performance and reduce costs.
#LLAMA_CPP_MODEL_VISION=C:\ai\models\llama\models\Qwen2.5-VL-3B
LLAMA_CPP_TIMEOUT_SECONDS=180
DEFAULT_LLM_PROVIDER=ll_ol_fallback
# Embeddfing model configuration, used for retrieval and any other embedding needs. Should be a smaller, more efficient model than the main LLMs.
EMBEDDING_MODEL_ID=OpenVINO/Qwen3-Embedding-0.6B-fp16-ov
EMBEDDING_MODEL_DIR=
EMBEDDING_DEVICE=AUTO:NPU
EMBEDDING_ALLOW_FALLBACK=0
EMBEDDING_FALLBACK_MODEL_ID=c:/ai/models/OpenVINO/Qwen3-Embedding-0.6B
EMBEDDING_FALLBACK_DEVICE=cpu
EMBEDDING_SERVICE_HOST=127.0.0.1
EMBEDDING_SERVICE_PORT=8030
EMBEDDING_SERVICE_BASE_URL=http://127.0.0.1:8030
EMBEDDING_SERVICE_TIMEOUT_SECONDS=10
EMBEDDING_QUEUE_REQUEST_STREAM=liara:embedding:requests
EMBEDDING_QUEUE_RESPONSE_STREAM_PREFIX=liara:embedding:responses
EMBEDDING_QUEUE_CONSUMER_GROUP=liara-embedding-workers
EMBEDDING_QUEUE_CONSUMER_NAME=embedding-worker-1
EMBEDDING_QUEUE_BLOCK_MS=1000
EMBEDDING_WORKER_ALLOW_HASH_FALLBACK=0
EMBEDDING_WORKER_FALLBACK_DIMENSIONS=1024
EMBEDDING_WORKER_MAX_INPUT_CHARS=8000
EMBEDDING_WORKER_LOG_LEVEL=INFO

# Native C++ embedding primary for services/embedding/app.py wrapper.
# Keep this URL different from EMBEDDING_SERVICE_BASE_URL when the Python wrapper
# itself is exposed as EMBEDDING_SERVICE_BASE_URL.
EMBEDDING_NATIVE_PRIMARY_ENABLED=1
EMBEDDING_NATIVE_SERVICE_BASE_URL=http://127.0.0.1:8031
EMBEDDING_NATIVE_TIMEOUT_SECONDS=2

# ============================================================================
# AI-Validator Configuration
# ============================================================================

# Execution Mode: worker (real configured backend) | mock (no runtime needed)
# Default: worker
# Development: mock (schnelle Tests ohne Docker)
LIARA_VALIDATOR_EXECUTION_MODE=mock

# Execution backend used in worker mode. docker_compose is currently bundled.
# VM, remote-worker, and other container adapters can register another name.
LIARA_VALIDATOR_BACKEND=docker_compose

# Async Job Execution (1=true, 0=false)
# Default: 1 (true) — Jobs laufen im Hintergrund, API antwortet schnell
LIARA_VALIDATOR_ASYNC=1

# Docker-Compose adapter configuration (ignored by other backends)
LIARA_VALIDATOR_WORKER_ROOT=./workers/ai-validator
LIARA_VALIDATOR_DOCKER_CLI=

# Backend-neutral preparation of native WSL workspaces
LIARA_VALIDATOR_ALLOWED_WSL_DISTROS=Debian
LIARA_VALIDATOR_WORKSPACE_MAX_FILES=2000
LIARA_VALIDATOR_WORKSPACE_MAX_BYTES=104857600

# Deprecated aliases retained for existing deployments:
# LIARA_VALIDATOR_WSL_DISTROS=Debian
# LIARA_VALIDATOR_SNAPSHOT_MAX_FILES=2000
# LIARA_VALIDATOR_SNAPSHOT_MAX_BYTES=104857600

# Validator Job Timeout (seconds, default=1800)
# Erhöhen für lange Analysen, senken für schnelle CI-Laufe
LIARA_VALIDATOR_TIMEOUT_SECONDS=1800

# ============================================================================
# Sys Governance Configuration (Optional)
# ============================================================================

# Enforce governance proposals for sys-tool invocations
# Default: 0 (disabled)
# Set to 1 for production to require approval for dangerous operations
LIARA_SYS_GOVERNANCE_ENFORCE=0
# off | risk_based | all; takes precedence over the legacy switch above.
LIARA_SYS_GOVERNANCE_MODE=off

# Path to store governance proposals (JSON snapshot with atomic writes)
# Default: ./logs/services/sys_governance_proposals.json
LIARA_SYS_GOVERNANCE_STORE_PATH=./logs/services/sys_governance_proposals.json

# Path to append-only governance events (JSONL format for audit trail)
# Default: ./logs/services/sys_governance_events.jsonl
LIARA_SYS_GOVERNANCE_EVENTS_PATH=./logs/services/sys_governance_events.jsonl
# Native WSL test/simulation sessions (canonical source stays on Windows)
LIARA_LOCAL_PROJECT_ROOT=C:\ai\LIARA
LIARA_WSL_SESSION_ROOT=/home/liara/workspace/sessions
LIARA_WSL_SESSION_ARTIFACTS=./artifacts/wsl_sessions
LIARA_WSL_SESSION_REGISTRY=./logs/services/wsl_sessions
LIARA_WSL_SESSION_AUDIT=./logs/services/wsl_sessions.jsonl
LIARA_WSL_SESSION_MAX_SNAPSHOT_BYTES=268435456
LIARA_WSL_SESSION_MAX_FILE_BYTES=33554432
LIARA_WSL_SESSION_MAX_PATCH_BYTES=8388608

# Bounded agentic workspace execution inside native WSL
LIARA_AGENT_WORKSPACE_ROOT=/home/liara/workspace
LIARA_AGENT_VALIDATOR_WORKSPACE=\\wsl.localhost\Debian\home\liara\workspace
LIARA_AGENT_VALIDATOR_TIMEOUT_SECONDS=180
LIARA_AGENT_SYS_MAX_ATTEMPTS=2
LIARA_AGENT_PLANNER_MAX_TOKENS=32768

# Runtime-controlled workspace .venv recovery. Only simple package specs whose
# normalized names occur here may be installed; URLs, VCS and local paths fail closed.
LIARA_AGENT_DEPENDENCY_ALLOWLIST=pydantic,pytest
LIARA_AGENT_DEPENDENCY_TIMEOUT_SECONDS=180
LIARA_AGENT_TEST_TIMEOUT_SECONDS=120
# Independent, vendor-neutral resource heartbeat instance (default port 8050).
LIARA_HEARTBEAT_INSTANCE_ID=liara.instance.heartbeat.local
LIARA_HEARTBEAT_NODE_ID=liara-local
LIARA_HEARTBEAT_INTERVAL_SECONDS=2
LIARA_HEARTBEAT_HISTORY_SECONDS=900
LIARA_HEARTBEAT_STALE_SECONDS=15
LIARA_HEARTBEAT_COLLECT=true
# native | json | csv; downstream contracts never expose source column names.
LIARA_HEARTBEAT_ADAPTER=native
LIARA_HEARTBEAT_SOURCE_PATH=
LIARA_HEARTBEAT_CSV_MAPPING_PATH=config/heartbeat_csv_mapping.example.json
LIARA_HEARTBEAT_ALLOW_EXTERNAL_INGEST=false
# Required only when external canonical observation batches are enabled.
LIARA_HEARTBEAT_INGEST_TOKEN=
LIARA_HEARTBEAT_BASE_URL=http://127.0.0.1:8050
LIARA_HEARTBEAT_PROXY_TIMEOUT_SECONDS=3

# Independent, read-only cyclic self-observer (default port 8060).
LIARA_SELF_OBSERVER_INSTANCE_ID=liara.instance.self-observer.local
LIARA_SELF_OBSERVER_NODE_ID=liara-local
LIARA_SELF_OBSERVER_INTERVAL_SECONDS=30
LIARA_SELF_OBSERVER_HISTORY_LIMIT=240
LIARA_SELF_OBSERVER_STORE_DIR=data/self_observer
LIARA_SELF_OBSERVER_COLLECT=true
LIARA_SELF_OBSERVER_API_BASE_URL=http://127.0.0.1:8010
LIARA_SELF_OBSERVER_HEARTBEAT_BASE_URL=http://127.0.0.1:8050
LIARA_SELF_OBSERVER_TIMEOUT_SECONDS=4
LIARA_SELF_OBSERVER_BACKEND_TIMEOUT_SECONDS=12
LIARA_SELF_OBSERVER_ASSURANCE_STALE_SECONDS=86400
LIARA_SELF_OBSERVER_QUIET_CANDIDATE_CYCLES=2
LIARA_SELF_OBSERVER_QUIET_STABLE_CYCLES=4
LIARA_SELF_OBSERVER_BASE_URL=http://127.0.0.1:8060
LIARA_SELF_OBSERVER_PROXY_TIMEOUT_SECONDS=4
# Assurance gate: observe computes eligibility only. submit requires an explicit workspace.
LIARA_SELF_INSPECTION_MODE=observe
LIARA_SELF_INSPECTION_WORKSPACE=
LIARA_SELF_INSPECTION_SCOPE=quick
LIARA_SELF_INSPECTION_STRICT=false
LIARA_SELF_INSPECTION_MIN_INTERVAL_SECONDS=21600
LIARA_SELF_INSPECTION_SUBMIT_TIMEOUT_SECONDS=30
LIARA_SELF_INSPECTION_TRACK_INTERVAL_SECONDS=1
LIARA_SELF_INSPECTION_CANARY_ENABLED=false
LIARA_SELF_INSPECTION_CANARY_TOKEN=
# MiniCPM/OpenVINO helper for semantic external-retrieval planning.
RETRIEVAL_INTENT_PROVIDER=ll_ol_fallback
RETRIEVAL_CANDIDATE_PROVIDER=ll_ol_fallback
