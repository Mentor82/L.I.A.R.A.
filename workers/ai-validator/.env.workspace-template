# AI Validator - Workspace Configuration Template
# Copy to .env.workspace-NAME and adjust for your project

# ============================================
# Project Identity
# ============================================
WORKSPACE_NAME=my-project
WORKSPACE_PATH=/path/to/my-project

# ============================================
# Container Configuration
# ============================================
CONTAINER_NAME=ai-validator-${WORKSPACE_NAME}
COMPOSE_PROJECT_NAME=ai-validator-${WORKSPACE_NAME}

# ============================================
# Reporting & Output
# ============================================
REPORT_DIR=/reports/${WORKSPACE_NAME}
STRICT_MODE=false

# ============================================
# Advanced Options (Optional)
# ============================================
# DEBUG_MODE=true
# CUSTOM_RULES=/workspace/linting-rules
# EXCLUDE_PATTERNS=node_modules,dist,build
