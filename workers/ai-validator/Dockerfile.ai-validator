# AI Validation Container - Multi-Language (Polyglot)
# Purpose: Isolated environment for AI-driven code validation (Python, JS, Bash, HTML, PHP, C/C++, etc.)
# Label: use_for_ai=true
# Policy: ai/POLICY/SECURITY.md

FROM python:3.12-slim

LABEL ai-validator="true" \
      languages="python,javascript,bash,html,css,php,c,cpp,typescript,yaml,json" \
      purpose="Multi-language code validation for AI workflows" \
      policy="ai/POLICY/SECURITY.md"

WORKDIR /workspace

# Install system & Node.js dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential gcc g++ git curl jq bash shellcheck php php-cli && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Python tools
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    pytest pytest-cov mypy black ruff pylint flake8 isort bandit yamllint

# Node.js tools
RUN npm install -g eslint prettier typescript htmlhint jsonlint 2>&1 | tail -3

# Copy AI policies (embedded in container)
COPY ai /opt/ai

# Copy validation scripts
COPY ai-validator-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/ai-validator-entrypoint.sh

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    NODE_ENV=production \
    AI_POLICY_PATH=/opt/ai

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)" && node -v || exit 1

# Default command: validation suite
ENTRYPOINT ["/usr/local/bin/ai-validator-entrypoint.sh"]
CMD ["validate"]
