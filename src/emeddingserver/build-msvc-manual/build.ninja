# Object build statements for OBJECT_LIBRARY target linep_scheduler


#############################################
# Order-only phony target for linep_scheduler

build cmake_object_order_depends_target_linep_scheduler: phony || cmake_object_order_depends_target_linep_core cmake_object_order_depends_target_linep_pal

build linep\src\scheduler\CMakeFiles\linep_scheduler.dir\score_engine.cpp.obj: CXX_COMPILER__linep_scheduler_unscanned_Release C$:\ai\LIARA\src\emeddingserver\linep\src\scheduler\score_engine.cpp || cmake_object_order_depends_target_linep_scheduler
  DEFINES = -DLINEP_BUILD_DAY=02 -DLINEP_BUILD_HOUR=10 -DLINEP_BUILD_MINUTE=00 -DLINEP_BUILD_MONTH=05 -DLINEP_BUILD_SECOND=30 -DLINEP_BUILD_YEAR_2D=26
  FLAGS = /DWIN32 /D_WINDOWS /EHsc /O2 /Ob2 /DNDEBUG -std:c++17 -MD
  INCLUDES = -IC:\ai\LIARA\src\emeddingserver\linep\src\scheduler -IC:\ai\LIARA\src\emeddingserver\linep\include -IC:\ai\LIARA\src\emeddingserver\linep\src\core -IC:\ai\LIARA\src\emeddingserver\linep\src\pal
  OBJECT_DIR = linep\src\scheduler\CMakeFiles\linep_scheduler.dir
  OBJECT_FILE_DIR = linep\src\scheduler\CMakeFiles\linep_scheduler.dir
  TARGET_COMPILE_PDB = linep\src\scheduler\CMakeFiles\linep_scheduler.dir\
  TARGET_PDB = ""

build linep\src\scheduler\CMakeFiles\linep_scheduler.dir\scheduler.cpp.obj: CXX_COMPILER__linep_scheduler_unscanned_Release C$:\ai\LIARA\src\emeddingserver\linep\src\scheduler\scheduler.cpp || cmake_object_order_depends_target_linep_scheduler
  DEFINES = -DLINEP_BUILD_DAY=02 -DLINEP_BUILD_HOUR=10 -DLINEP_BUILD_MINUTE=00 -DLINEP_BUILD_MONTH=05 -DLINEP_BUILD_SECOND=30 -DLINEP_BUILD_YEAR_2D=26
  FLAGS = /DWIN32 /D_WINDOWS /EHsc /O2 /Ob2 /DNDEBUG -std:c++17 -MD
  INCLUDES = -IC:\ai\LIARA\src\emeddingserver\linep\src\scheduler -IC:\ai\LIARA\src\emeddingserver\linep\include -IC:\ai\LIARA\src\emeddingserver\linep\src\core -IC:\ai\LIARA\src\emeddingserver\linep\src\pal
  OBJECT_DIR = linep\src\scheduler\CMakeFiles\linep_scheduler.dir
  OBJECT_FILE_DIR = linep\src\scheduler\CMakeFiles\linep_scheduler.dir
  TARGET_COMPILE_PDB = linep\src\scheduler\CMakeFiles\linep_scheduler.dir\
  TARGET_PDB = ""



#############################################
# Object library linep_scheduler

build linep\src\scheduler\linep_scheduler: phony linep\src\scheduler\CMakeFiles\linep_scheduler.dir\score_engine.cpp.obj linep\src\scheduler\CMakeFiles\linep_scheduler.dir\scheduler.cpp.obj


#############################################
# Utility command for edit_cache

build linep\src\scheduler\CMakeFiles\edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\ai\LIARA\src\emeddingserver\build-msvc-manual\linep\src\scheduler && C:\Strawberry\c\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build linep\src\scheduler\edit_cache: phony linep\src\scheduler\CMakeFiles\edit_cache.util


#############################################
# Utility command for rebuild_cache

build linep\src\scheduler\CMakeFiles\rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\ai\LIARA\src\emeddingserver\build-msvc-manual\linep\src\scheduler && C:\Strawberry\c\bin\cmake.exe --regenerate-during-build -SC:\ai\LIARA\src\emeddingserver -BC:\ai\LIARA\src\emeddingserver\build-msvc-manual"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build linep\src\scheduler\rebuild_cache: phony linep\src\scheduler\CMakeFiles\rebuild_cache.util

# =============================================================================
