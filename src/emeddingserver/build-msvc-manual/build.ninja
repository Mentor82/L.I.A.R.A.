build LiaraEmbeddingService: phony LiaraEmbeddingService.exe

build linep: phony linep\linep.lib

build linep.lib: phony linep\linep.lib

build linep_core: phony linep\src\core\linep_core

build linep_pal: phony linep\src\pal\linep_pal

build linep_scheduler: phony linep\src\scheduler\linep_scheduler

build linep_tcp: phony linep\src\tcp\linep_tcp

build linep_udp: phony linep\src\udp\linep_udp

